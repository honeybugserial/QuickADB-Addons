diff --git a/modules/scrcpy.py b/modules/scrcpy.py
new file mode 100644
index 0000000..3294e82
--- /dev/null
+++ b/modules/scrcpy.py
@@ -0,0 +1,822 @@
+"""
+scrcpy.py - Screen mirroring / control launcher for QuickADB, powered by Genymobile's scrcpy.
+
+scrcpy is NOT bundled (similar to FFmpeg). It is looked up in this order:
+  1. Anywhere under <QuickADB folder>/bin, whatever the subfolders are called
+     (e.g. bin/scrcpy.exe, bin/scrcpy-win64-v3.3.4/scrcpy.exe)
+  2. A path the user picked previously with "Browse..." (remembered via QSettings)
+  3. The system PATH
+  4. Common install locations that may be missing from PATH (winget, Scoop,
+     Chocolatey, Homebrew, Snap, ~/.local/bin, ...)
+
+The "QuickADB folder" is the folder containing main.py when run from source, or the
+folder containing the QuickADB executable in a packaged build.
+
+scrcpy is launched with QuickADB's own adb (via the ADB environment variable) and the
+device selected in the main window's dropdown, so both tools share one adb server.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import platform
+import re
+import shutil
+import ssl
+import tarfile
+import urllib.request
+import zipfile
+import subprocess
+import sys
+from typing import List, Optional
+
+from util.resource import get_clean_env, get_root_dir, open_url_safe
+from util.toolpaths import ToolPaths
+from util.devicemanager import DeviceManager
+from util.thememanager import ThemeManager
+
+root_dir = get_root_dir()
+if root_dir not in sys.path:
+    sys.path.insert(0, root_dir)
+
+from PyQt6.QtCore import Qt, QThread, QSettings, QTimer, pyqtSignal
+from PyQt6.QtGui import QTextCursor
+from PyQt6.QtWidgets import (
+    QApplication,
+    QCheckBox,
+    QComboBox,
+    QFileDialog,
+    QGridLayout,
+    QGroupBox,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
+    QMainWindow,
+    QMessageBox,
+    QPlainTextEdit,
+    QProgressDialog,
+    QPushButton,
+    QSpinBox,
+    QVBoxLayout,
+    QWidget,
+)
+
+MODULE_VERSION = 6  # bump when this file changes; shown in the window and by add_scrcpy.py
+
+SCRCPY_URL = "https://github.com/Genymobile/scrcpy#get-the-app"
+SCRCPY_RELEASES_API = "https://api.github.com/repos/Genymobile/scrcpy/releases/latest"
+MISSING_COLOR = "#ff6666"
+SETTINGS_KEY_PATH = "scrcpy/path"
+
+# Hides the console window scrcpy would otherwise open on Windows.
+_CREATE_NO_WINDOW = 0x08000000 if os.name == "nt" else 0
+
+
+def _settings() -> QSettings:
+    return QSettings("QuickADB", "QuickADB")
+
+
+def _exe_name() -> str:
+    return "scrcpy.exe" if os.name == "nt" else "scrcpy"
+
+
+def app_dir() -> str:
+    """Folder the user sees QuickADB in (not PyInstaller's temporary extraction folder)."""
+    if getattr(sys, "frozen", False):
+        exe = sys.executable
+        # Linux AppImage: the real file lives outside the mounted image
+        exe = os.environ.get("APPIMAGE", exe)
+        return os.path.dirname(os.path.abspath(exe))
+    return get_root_dir()
+
+
+BIN_SEARCH_DEPTH = 4  # how many folder levels below bin/ to look
+
+
+def _version_key(path: str) -> tuple:
+    """Extract a version like v3.3.4 from the folder names, for picking the newest copy."""
+    import re
+    m = re.findall(r"v?(\d+)\.(\d+)(?:\.(\d+))?", path.replace("\\", "/"))
+    if not m:
+        return (0, 0, 0)
+    return tuple(int(x or 0) for x in m[-1])
+
+
+def _local_bin_candidates() -> List[str]:
+    """Find every scrcpy executable anywhere under <QuickADB>/bin (up to BIN_SEARCH_DEPTH levels),
+    whatever the folders are called, e.g. bin/scrcpy.exe, bin/scrcpy/scrcpy.exe,
+    bin/scrcpy-win64-v3.3.4/scrcpy.exe, bin/tools/Scrcpy 3.3/scrcpy.exe.
+
+    Best match first: a copy with scrcpy-server next to it (a complete release folder),
+    then the shallowest, then the newest version found in the folder name."""
+    base = os.path.join(app_dir(), "bin")
+    if not os.path.isdir(base):
+        return []
+    exe = _exe_name().lower()
+    base_depth = base.rstrip(os.sep).count(os.sep)
+    found = []
+    for dirpath, dirnames, filenames in os.walk(base):
+        depth = dirpath.rstrip(os.sep).count(os.sep) - base_depth
+        if depth >= BIN_SEARCH_DEPTH:
+            dirnames[:] = []  # don't descend further
+        dirnames.sort()
+        lower = {f.lower(): f for f in filenames}
+        if exe in lower:
+            path = os.path.join(dirpath, lower[exe])
+            has_server = "scrcpy-server" in lower
+            found.append((not has_server, depth, tuple(-v for v in _version_key(os.path.relpath(path, base))), path))
+    return [path for *_, path in sorted(found)]
+
+
+def _common_install_candidates() -> List[str]:
+    """Typical install spots, for when scrcpy is installed but not on this process's PATH
+    (e.g. GUI apps on macOS don't inherit Homebrew's PATH)."""
+    home = os.path.expanduser("~")
+    exe = _exe_name()
+    if os.name == "nt":
+        local = os.environ.get("LOCALAPPDATA", os.path.join(home, "AppData", "Local"))
+        program_data = os.environ.get("ProgramData", r"C:\ProgramData")
+        cands = [
+            os.path.join(local, "Microsoft", "WinGet", "Links", exe),
+            os.path.join(home, "scoop", "shims", exe),
+            os.path.join(program_data, "chocolatey", "bin", exe),
+        ]
+        # winget's unpacked package folder, e.g. Genymobile.scrcpy_.../scrcpy-win64-v3.x/scrcpy.exe
+        pkgs = os.path.join(local, "Microsoft", "WinGet", "Packages")
+        if os.path.isdir(pkgs):
+            for name in sorted(os.listdir(pkgs), reverse=True):
+                if name.lower().startswith("genymobile.scrcpy"):
+                    pkg = os.path.join(pkgs, name)
+                    for sub in sorted(os.listdir(pkg), reverse=True):
+                        cands.append(os.path.join(pkg, sub, exe))
+                    cands.append(os.path.join(pkg, exe))
+        return cands
+    return [
+        "/opt/homebrew/bin/scrcpy",
+        "/usr/local/bin/scrcpy",
+        "/usr/bin/scrcpy",
+        "/snap/bin/scrcpy",
+        os.path.join(home, ".local", "bin", "scrcpy"),
+        os.path.join(home, "bin", "scrcpy"),
+    ]
+
+
+def _usable(path: Optional[str]) -> bool:
+    return bool(path) and os.path.isfile(path) and (os.name == "nt" or os.access(path, os.X_OK))
+
+
+def find_scrcpy_with_source() -> tuple[Optional[str], str]:
+    """Return (path, where-it-was-found), or (None, "") if scrcpy isn't available."""
+    for cand in _local_bin_candidates():
+        if _usable(cand):
+            return cand, "QuickADB bin folder"
+
+    saved = _settings().value(SETTINGS_KEY_PATH, "", type=str)
+    if _usable(saved):
+        return saved, "chosen with Browse"
+
+    on_path = shutil.which("scrcpy")
+    if on_path:
+        return on_path, "system PATH"
+
+    for cand in _common_install_candidates():
+        if _usable(cand):
+            return cand, "system install"
+
+    return None, ""
+
+
+def find_scrcpy() -> Optional[str]:
+    """Return a usable scrcpy executable path, or None."""
+    return find_scrcpy_with_source()[0]
+
+
+def scrcpy_env() -> dict:
+    """Environment for scrcpy: clean env + QuickADB's adb, so we don't start a second adb server."""
+    env = get_clean_env()
+    adb = ToolPaths.instance().adb
+    if adb and os.path.isfile(adb):
+        env["ADB"] = adb
+        env["PATH"] = os.path.dirname(adb) + os.pathsep + env.get("PATH", "")
+    return env
+
+
+def get_scrcpy_version(exe: str) -> Optional[str]:
+    try:
+        proc = subprocess.run(
+            [exe, "--version"], capture_output=True, text=True, timeout=8,
+            env=scrcpy_env(), creationflags=_CREATE_NO_WINDOW,
+        )
+        first = (proc.stdout or proc.stderr).strip().splitlines()
+        return first[0].strip() if first else None
+    except Exception:
+        return None
+
+
+def release_asset_pattern() -> Optional[str]:
+    """Regex for this OS's scrcpy release archive, e.g. scrcpy-win64-v3.3.4.zip. None if unsupported."""
+    system, machine = platform.system(), platform.machine().lower()
+    arm = machine in ("arm64", "aarch64")
+    if system == "Windows":
+        arch = "winarm64" if arm else ("win64" if sys.maxsize > 2**32 or machine.endswith("64") else "win32")
+        return rf"^scrcpy-{arch}-v[\d.]+\.zip$"
+    if system == "Darwin":
+        return rf"^scrcpy-macos-{'aarch64' if arm else 'x86_64'}-v[\d.]+\.tar\.gz$"
+    if system == "Linux" and machine in ("x86_64", "amd64"):
+        return r"^scrcpy-linux-x86_64-v[\d.]+\.tar\.gz$"
+    return None
+
+
+def _ssl_context() -> ssl.SSLContext:
+    try:
+        import certifi
+        return ssl.create_default_context(cafile=certifi.where())
+    except Exception:
+        return ssl.create_default_context()
+
+
+def _open(url: str, timeout: float = 30):
+    req = urllib.request.Request(url, headers={"User-Agent": "QuickADB",
+                                               "Accept": "application/vnd.github+json"})
+    return urllib.request.urlopen(req, timeout=timeout, context=_ssl_context())
+
+
+def _safe_extract(archive: str, dest: str):
+    """Extract a .zip or .tar.gz into dest, refusing paths that escape it."""
+    dest_real = os.path.realpath(dest)
+
+    def check(name: str):
+        target = os.path.realpath(os.path.join(dest, name))
+        if target != dest_real and not target.startswith(dest_real + os.sep):
+            raise ValueError(f"Unsafe path in archive: {name}")
+
+    if archive.endswith(".zip"):
+        with zipfile.ZipFile(archive) as z:
+            for n in z.namelist():
+                check(n)
+            z.extractall(dest)
+    else:
+        with tarfile.open(archive, "r:gz") as t:
+            members = t.getmembers()
+            for m in members:
+                check(m.name)
+                if m.issym() or m.islnk():
+                    check(os.path.join(os.path.dirname(m.name), m.linkname))
+            t.extractall(dest, members=members)
+
+
+class ScrcpyDownloader(QThread):
+    """Downloads the latest scrcpy release for this OS into <QuickADB>/bin and unpacks it."""
+    progress = pyqtSignal(int, int)  # bytes done, total
+    status = pyqtSignal(str)
+    done = pyqtSignal(str)           # extracted folder
+    failed = pyqtSignal(str)
+
+    def __init__(self, dest: str):
+        super().__init__()
+        self.dest = dest
+        self._cancel = False
+
+    def cancel(self):
+        self._cancel = True
+
+    def run(self):
+        archive = None
+        try:
+            pattern = release_asset_pattern()
+            if not pattern:
+                raise RuntimeError(f"No prebuilt scrcpy for {platform.system()} {platform.machine()}.")
+            self.status.emit("Looking up the latest scrcpy release...")
+            with _open(SCRCPY_RELEASES_API) as resp:
+                release = json.load(resp)
+            assets = release.get("assets", [])
+            asset = next((a for a in assets if re.search(pattern, a.get("name", ""))), None)
+            if not asset:
+                raise RuntimeError(f"Release {release.get('tag_name', '?')} has no file for this system.")
+            name = asset["name"]
+
+            # Expected SHA-256: GitHub's asset digest, else the release's SHA256SUMS.txt
+            expected = None
+            digest = asset.get("digest") or ""
+            if digest.startswith("sha256:"):
+                expected = digest.split(":", 1)[1].lower()
+            else:
+                sums = next((a for a in assets if a.get("name") == "SHA256SUMS.txt"), None)
+                if sums:
+                    with _open(sums["browser_download_url"]) as resp:
+                        for line in resp.read().decode("utf-8", "replace").splitlines():
+                            parts = line.split()
+                            if len(parts) == 2 and parts[1].lstrip("*") == name:
+                                expected = parts[0].lower()
+
+            os.makedirs(self.dest, exist_ok=True)
+            archive = os.path.join(self.dest, name + ".part")
+            self.status.emit(f"Downloading {name}...")
+            h = hashlib.sha256()
+            with _open(asset["browser_download_url"], timeout=60) as resp, open(archive, "wb") as out:
+                total = int(resp.headers.get("Content-Length") or asset.get("size") or 0)
+                got = 0
+                while True:
+                    if self._cancel:
+                        raise InterruptedError("Download cancelled.")
+                    chunk = resp.read(256 * 1024)
+                    if not chunk:
+                        break
+                    out.write(chunk)
+                    h.update(chunk)
+                    got += len(chunk)
+                    self.progress.emit(got, total)
+
+            if expected and h.hexdigest() != expected:
+                raise RuntimeError("Checksum mismatch: the download is corrupt or was tampered with.")
+
+            self.status.emit("Extracting...")
+            final = archive[:-len(".part")]
+            os.replace(archive, final)
+            archive = final
+            _safe_extract(archive, self.dest)
+            folder = os.path.join(self.dest, re.sub(r"\.(zip|tar\.gz)$", "", name))
+            if os.name != "nt" and os.path.isfile(os.path.join(folder, "scrcpy")):
+                os.chmod(os.path.join(folder, "scrcpy"), 0o755)
+            self.done.emit(folder)
+        except Exception as e:
+            self.failed.emit(str(e))
+        finally:
+            if archive and os.path.exists(archive):
+                try:
+                    os.remove(archive)
+                except OSError:
+                    pass
+

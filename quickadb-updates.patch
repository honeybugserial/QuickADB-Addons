+class ScrcpyWorker(QThread):
+    """Runs one scrcpy session and streams its output."""
+    line_ready = pyqtSignal(str)
+    finished_signal = pyqtSignal(int)
+
+    def __init__(self, cmd: List[str]):
+        super().__init__()
+        self.cmd = cmd
+        self.process: Optional[subprocess.Popen] = None
+
+    def run(self):
+        try:
+            self.process = subprocess.Popen(
+                self.cmd,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                stdin=subprocess.DEVNULL,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+                bufsize=1,
+                env=scrcpy_env(),
+                creationflags=_CREATE_NO_WINDOW,
+            )
+        except Exception as e:
+            self.line_ready.emit(f"Failed to start scrcpy: {e}")
+            self.finished_signal.emit(-1)
+            return
+
+        assert self.process.stdout is not None
+        for line in self.process.stdout:
+            line = line.rstrip()
+            if line:
+                self.line_ready.emit(line)
+        self.finished_signal.emit(self.process.wait())
+
+    def stop(self):
+        """Ask scrcpy to exit gracefully (lets recordings finalize), then force it."""
+        p = self.process
+        if p is None or p.poll() is not None:
+            return
+        try:
+            p.terminate()
+            p.wait(timeout=3)
+        except subprocess.TimeoutExpired:
+            p.kill()
+        except Exception:
+            pass
+
+
+class DeviceScanWorker(QThread):
+    """Runs DeviceManager.refresh() off the UI thread (adb + getprop can take a few seconds)."""
+    done = pyqtSignal(list)
+
+    def run(self):
+        try:
+            self.done.emit(DeviceManager.instance().refresh())
+        except Exception:
+            self.done.emit([])
+

+    def _prompt_missing(self):
+        bin_dir = os.path.join(app_dir(), "bin")
+        resp = QMessageBox.question(
+            self, "scrcpy not found",
+            "scrcpy wasn't found in QuickADB's bin folder or on the system.\n\n"
+            "Download the latest scrcpy release from GitHub now?\n"
+            f"It will be saved to:\n{bin_dir}",
+            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
+            QMessageBox.StandardButton.Yes,
+        )
+        if resp == QMessageBox.StandardButton.Yes:
+            self.download_scrcpy()
+
+    def download_scrcpy(self):
+        if getattr(self, "_dl_worker", None) is not None:
+            return
+        bin_dir = os.path.join(app_dir(), "bin")
+        dlg = QProgressDialog("Looking up the latest scrcpy release...", "Cancel", 0, 0, self)
+        dlg.setWindowTitle("Get scrcpy")
+        dlg.setWindowModality(Qt.WindowModality.WindowModal)
+        dlg.setMinimumDuration(0)
+        dlg.setAutoClose(False)
+        dlg.setAutoReset(False)
+
+        worker = ScrcpyDownloader(bin_dir)
+        self._dl_worker = worker
+        self.get_btn.setEnabled(False)
+
+        def on_progress(got, total):
+            if total:
+                dlg.setMaximum(total)
+                dlg.setValue(got)
+            mb = f"{got / 1048576:.1f}" + (f" / {total / 1048576:.1f}" if total else "")
+            dlg.setLabelText(f"Downloading scrcpy... {mb} MB")
+
+        def finish(folder: Optional[str], error: str = ""):
+            dlg.close()
+            worker.wait(2000)
+            self._dl_worker = None
+            self.get_btn.setEnabled(True)
+            if folder:
+                self._log(f"scrcpy installed to {folder}")
+                self.scrcpy_path, self.scrcpy_source = find_scrcpy_with_source()
+                self._refresh_scrcpy_label()
+                if not self.scrcpy_path:
+                    QMessageBox.warning(self, "Get scrcpy", f"Downloaded to {folder}, but scrcpy still wasn't found there.")
+            elif error != "Download cancelled.":
+                self._log(f"scrcpy download failed: {error}")
+                resp = QMessageBox.warning(
+                    self, "Get scrcpy",
+                    f"Couldn't download scrcpy:\n{error}\n\n"
+                    f"You can get it manually and unzip it into:\n{bin_dir}\n\nOpen the download page?",
+                    QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
+                if resp == QMessageBox.StandardButton.Yes:
+                    open_url_safe(SCRCPY_URL)
+
+        worker.progress.connect(on_progress)
+        worker.status.connect(dlg.setLabelText)
+        worker.done.connect(lambda folder: finish(folder))
+        worker.failed.connect(lambda msg: finish(None, msg))
+        dlg.canceled.connect(worker.cancel)
+        worker.start()
+        dlg.show()
+
+    def _refresh_scrcpy_label(self):
+        if self.scrcpy_path:
+            version = get_scrcpy_version(self.scrcpy_path) or "scrcpy (unknown version)"
+            version = version.split("<")[0].strip()  # drop the "<github url>" suffix
+            source = f"  ({self.scrcpy_source})" if self.scrcpy_source else ""
+            self.scrcpy_label.setText(version + source)
+            self.scrcpy_label.setStyleSheet("")
+            self.scrcpy_label.setToolTip(self.scrcpy_path)
+            self.start_btn.setEnabled(self.worker is None)
+        else:
+            self.scrcpy_label.setText(f"Not found in {os.path.join(app_dir(), 'bin')} or on the system. "
+                                      "Unzip scrcpy into that bin folder, or use Browse.")
+            self.scrcpy_label.setWordWrap(True)
+            self.scrcpy_label.setStyleSheet(f"color: {MISSING_COLOR}; font-weight: bold;")
+            self.scrcpy_label.setToolTip(f"Looked in {os.path.join(app_dir(), 'bin')}, the system PATH "
+                                         "and common install locations.")
+            self.start_btn.setEnabled(False)

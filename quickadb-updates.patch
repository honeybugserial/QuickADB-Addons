+    def scan_devices(self):
+        if self.scan_worker is not None and self.scan_worker.isRunning():
+            return
+        self.scan_btn.setEnabled(False)
+        self.device_combo.setPlaceholderText("Scanning...")
+        self.scan_worker = DeviceScanWorker()
+        self.scan_worker.done.connect(self._fill_devices)
+        self.scan_worker.start()
+
+    def _fill_devices(self, devices: list):
+        """List devices scrcpy can use (adb state 'device'), preselecting the main window's choice."""
+        self.scan_btn.setEnabled(True)
+        self.device_combo.setPlaceholderText("No devices found, press ⟳ to scan")
+        previous = self.device_combo.currentData() or DeviceManager.instance().selected_serial
+
+        self.device_combo.clear()
+        skipped = []
+        for dev in devices:
+            if dev.get("state") != "device":
+                skipped.append(f"{dev.get('serial')} [{dev.get('state')}]")
+                continue
+            name = dev.get("name") or dev["serial"]
+            label = name if name == dev["serial"] else f"{name}  ({dev['serial']})"
+            self.device_combo.addItem(label, userData=dev["serial"])
+
+        if previous:
+            idx = self.device_combo.findData(previous)
+            if idx >= 0:
+                self.device_combo.setCurrentIndex(idx)
+        if self.device_combo.currentIndex() < 0 and self.device_combo.count() > 0:
+            self.device_combo.setCurrentIndex(0)
+
+        if skipped:
+            self._log("Not usable by scrcpy (must be booted with USB debugging authorized): "
+                      + ", ".join(skipped))
+
+    def _browse_scrcpy(self):
+        filt = "scrcpy (scrcpy.exe);;All Files (*)" if os.name == "nt" else "All Files (*)"
+        path, _ = QFileDialog.getOpenFileName(self, "Locate scrcpy executable", "", filt)
+        if not path:
+            return
+        if not get_scrcpy_version(path):
+            QMessageBox.warning(self, "scrcpy", "That file didn't respond like scrcpy (--version failed).")
+            return
+        _settings().setValue(SETTINGS_KEY_PATH, path)
+        self.scrcpy_path, self.scrcpy_source = path, "chosen with Browse"
+        self._refresh_scrcpy_label()
+
+    def _on_record_toggled(self, checked: bool):
+        self.record_path.setEnabled(checked)
+        self.record_browse.setEnabled(checked)
+
+    def _browse_record(self):
+        path, _ = QFileDialog.getSaveFileName(
+            self, "Save recording as", "recording.mp4", "MP4 (*.mp4);;Matroska (*.mkv)"
+        )
+        if path:
+            self.record_path.setText(path)
+
+    def _log(self, text: str):
+        self.output.appendPlainText(text)
+        self.output.moveCursor(QTextCursor.MoveOperation.End)
+
+    def build_command(self) -> List[str]:
+        cmd = [self.scrcpy_path]
+        serial = self.device_combo.currentData()
+        if serial:
+            cmd.append(f"--serial={serial}")
+
+        if self.max_size.currentText() != "Original":
+            cmd.append(f"--max-size={self.max_size.currentText()}")
+        cmd.append(f"--video-bit-rate={self.bitrate.value()}M")
+        if self.max_fps.value() > 0:
+            cmd.append(f"--max-fps={self.max_fps.value()}")
+        if self.codec.currentText() != "h264":
+            cmd.append(f"--video-codec={self.codec.currentText()}")
+
+        flags = [
+            (not self.audio_cb.isChecked(), "--no-audio"),
+            (self.screen_off_cb.isChecked(), "--turn-screen-off"),
+            (self.stay_awake_cb.isChecked(), "--stay-awake"),
+            (self.show_touches_cb.isChecked(), "--show-touches"),
+            (self.view_only_cb.isChecked(), "--no-control"),
+            (self.power_off_cb.isChecked(), "--power-off-on-close"),
+            (self.on_top_cb.isChecked(), "--always-on-top"),
+            (self.fullscreen_cb.isChecked(), "--fullscreen"),
+            (self.borderless_cb.isChecked(), "--window-borderless"),
+        ]
+        cmd += [flag for enabled, flag in flags if enabled]
+
+        if self.record_cb.isChecked():
+            cmd.append(f"--record={self.record_path.text().strip() or 'recording.mp4'}")
+
+        device_name = self.device_combo.currentText().split("  (")[0] if serial else "scrcpy"
+        cmd.append(f"--window-title=QuickADB - {device_name}")
+
+        extra = self.extra_args.text().strip()
+        if extra:
+            import shlex
+            cmd += shlex.split(extra, posix=(os.name != "nt"))
+        return cmd
+
+    # --- Session control ---
+
+    def start_mirroring(self):
+        if self.worker is not None:
+            return
+        if not _usable(self.scrcpy_path):
+            self.scrcpy_path, self.scrcpy_source = find_scrcpy_with_source()
+            self._refresh_scrcpy_label()
+        if not self.scrcpy_path:
+            QMessageBox.warning(
+                self, "scrcpy not found",
+                "scrcpy wasn't found.\n\nUnzip it anywhere inside:\n" + os.path.join(app_dir(), "bin") +
+                "\n\nor install it system-wide, or use Browse to locate it.")
+            return
+        if self.device_combo.count() == 0:
+            QMessageBox.warning(self, "No device",
+                                "No usable device found. Connect one (USB or wireless) and press ⟳.")
+            return
+        try:
+            cmd = self.build_command()
+        except ValueError as e:
+            QMessageBox.warning(self, "Extra arguments", f"Couldn't parse extra arguments: {e}")
+            return
+
+        self._log("$ " + " ".join(cmd))
+        self.worker = ScrcpyWorker(cmd)
+        self.worker.line_ready.connect(self._log)
+        self.worker.finished_signal.connect(self._on_finished)
+        self.worker.start()
+        self.start_btn.setEnabled(False)
+        self.stop_btn.setEnabled(True)
+        self.status_label.setText("Running")
+
+    def stop_mirroring(self):
+        if self.worker is not None:
+            self.status_label.setText("Stopping...")
+            self.worker.stop()
+
+    def _on_finished(self, code: int):
+        self._log(f"scrcpy exited with code {code}")
+        if self.worker is not None:
+            self.worker.wait(1000)
+        self.worker = None
+        self.stop_btn.setEnabled(False)
+        self.status_label.setText("Idle" if code == 0 else f"Exited ({code})")
+        self._refresh_scrcpy_label()
+
+    def closeEvent(self, event):
+        if getattr(self, "_dl_worker", None) is not None:
+            self._dl_worker.cancel()
+            self._dl_worker.wait(5000)
+        if self.scan_worker is not None:
+            self.scan_worker.wait(5000)
+        if self.worker is not None:
+            self.worker.stop()
+            self.worker.wait(4000)
+        super().closeEvent(event)
+
